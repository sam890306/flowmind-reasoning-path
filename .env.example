# Postgres connection string (Neon / Supabase / any Postgres 14+). On Vercel use the pooled URL.
DATABASE_URL=postgres://ar:ar@localhost:5432/ar

# 32+ random characters; signs the session cookie.  openssl rand -base64 48
SESSION_SECRET=

# Google OAuth client (Web application). Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the console, no trailing slash. Needed on Vercel so the redirect URI is stable.
APP_URL=http://localhost:5173

# Comma-separated emails that become operators when they sign in. At least one is required to bootstrap.
OPERATOR_EMAILS=

# Optional: only these Google Workspace domains may sign in (comma-separated).
ALLOWED_EMAIL_DOMAINS=

# Optional lab settings applied by the migration.
LAB_NAME=
LAB_SLOTS=9

# Local development only. Enables POST /api/auth/dev (sign in as any email). Ignored in Vercel production.
AUTH_DEV_LOGIN=
